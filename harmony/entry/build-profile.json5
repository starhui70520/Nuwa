{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "abiFilters": ["arm64-v8a", "x86_64"]
    },
    "sourceOption": {
      "workers": [
        "./src/main/ets/workers/HarmonyOfflineEnglishWorker.ets",
        "./src/main/ets/workers/NativeCodeHighlightWorker.ets"
      ]
    }
  },
  "targets": [
    {
      "name": "default"
    }
  ]
}
