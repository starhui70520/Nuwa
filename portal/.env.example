# 服务端口
PORT=3100

# 管理后台密码（请务必在生产环境中修改）
ADMIN_PASSWORD=rankchord-admin

# 存储模式: minio | local
# 若未配置 MINIO_ENDPOINT，系统会自动回退到 local 本地存储方便开发预览
STORAGE_DRIVER=minio

# MinIO 配置
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nuwa-releases

# 可选：如果 MinIO 对外暴露了反代域名（如 https://cdn.rankchord.com），可配置公开下载基地址
# 留空则由后端生成 MinIO 预签名下载链接（默认有效期 1 小时）
MINIO_PUBLIC_URL=
MINIO_PRESIGN_EXPIRY=3600
